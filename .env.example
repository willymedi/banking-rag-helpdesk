# OpenAI
OPENAI_API_KEY=sk-...

# API Auth (header X-API-Key)
API_KEY=mesa-demo-key

# Langfuse (self-hosted, defaults work for local demo)
LANGFUSE_PUBLIC_KEY=pk-lf-mesa-public
LANGFUSE_SECRET_KEY=sk-lf-mesa-secret
LANGFUSE_NEXTAUTH_SECRET=mesa-langfuse-secret-change-me
LANGFUSE_SALT=mesa-langfuse-salt-change-me

# Tuning
ENABLE_RERANKER=false
CONFIDENCE_THRESHOLD=0.65
RATE_LIMIT_PER_MIN=10
